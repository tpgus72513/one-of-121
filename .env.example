# 이 파일을 복사해서 .env.local 로 만들고 값을 채운다. (.env.local은 커밋되지 않음)
# 실제 값은 팀 단톡방/노션에서 공유한다. 절대 이 파일에 진짜 키를 넣지 않는다.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버(API 라우트)에서만 쓰는 키. NEXT_PUBLIC_ 붙이면 브라우저에 노출되니 절대 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# AI 결과 카드용 LLM API 키 (서버 전용)
LLM_API_KEY=
