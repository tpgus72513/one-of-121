# 이 파일을 복사해서 .env.local 로 만들고 값을 채운다. (.env.local은 커밋되지 않음)
# 값은 각자 Supabase 대시보드(팀원으로 초대받은 계정)에서 직접 복사한다.
# 특히 SUPABASE_SERVICE_ROLE_KEY 는 단톡방·노션·커밋 어디에도 붙이지 않는다 (DB 전체 권한).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버(API 라우트)에서만 쓰는 키. NEXT_PUBLIC_ 붙이면 브라우저에 노출되니 절대 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# AI 결과 카드용 LLM API 키 (서버 전용)
LLM_API_KEY=
